{
  "name": "palbeacon-cli",
  "version": "0.2.5",
  "description": "Read-only Palworld inventory synchronization client for PalBeacon",
  "type": "module",
  "private": false,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "palbeacon": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs --release",
    "lint": "eslint src tests scripts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@palhatch/contracts": "workspace:^",
    "@types/node": "22.18.10",
    "esbuild": "0.28.1",
    "eslint": "9.38.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vitest": "3.2.4"
  }
}
