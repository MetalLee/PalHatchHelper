# Web (public browser-safe placeholders only)
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=example-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web server only (Steam OpenID and public Sync)
STEAM_WEB_API_KEY=
ENABLE_PASSWORD_LOGIN=true
SYNC_MAX_PAYLOAD_BYTES=5242880
SYNC_PAIRING_CODE_TTL_SECONDS=600
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Agent (server-only placeholders)
APP_ENV=development
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=example-service-role-key
PALHATCH_DATA_DIR=./data
GAME_CATALOG_BUCKET=game-catalog-artifacts
GAME_CATALOG_CACHE_MAX_VERSIONS=2
BREEDING_REMOTE_SOURCES_ENABLED=false
BREEDING_SOURCE_TIMEOUT_SECONDS=30
BREEDING_SOURCE_MAXIMUM_BYTES=10485760
PALWORLD_COMPOSE_DIR=/opt/palworld
PALWORLD_SAVE_ROOT=/confirmed/host/save/path
# The Save Worker mounts the self-contained Parser bundle read-only; no separate decoder runtime is configured here.

# Supabase local tooling
SUPABASE_PROJECT_ID=example-project-id

# AI Provider (server-only placeholders)
OPENAI_API_KEY=example-api-key
AI_PROVIDER=template
