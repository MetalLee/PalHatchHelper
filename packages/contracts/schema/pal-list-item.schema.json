{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palhatch.local/schemas/pal-list-item.schema.json",
  "title": "PalListItem",
  "description": "Safe inventory projection returned by list_available_pals; raw metadata is excluded.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "PalGender": {
      "type": "string",
      "enum": ["male", "female", "genderless", "unknown"]
    },
    "PalLocationType": {
      "type": "string",
      "enum": [
        "player_party",
        "player_storage",
        "base",
        "dimensional_storage",
        "viewing_cage",
        "unknown"
      ]
    }
  },
  "required": [
    "snapshot_id",
    "pal_instance_uid",
    "pal_id",
    "is_boss",
    "owner_player_id",
    "owner_display_name",
    "guild_id",
    "gender",
    "level",
    "passive_skill_ids",
    "location_type",
    "location_name",
    "location_id",
    "location_slot_index",
    "location_access_scope",
    "share_enabled",
    "is_owned_by_requester"
  ],
  "properties": {
    "snapshot_id": { "type": "string", "format": "uuid" },
    "pal_instance_uid": { "type": "string", "minLength": 1, "maxLength": 160 },
    "pal_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "is_boss": { "type": ["boolean", "null"] },
    "owner_player_id": { "type": "string", "format": "uuid" },
    "owner_display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "guild_id": { "type": ["string", "null"], "format": "uuid" },
    "gender": { "$ref": "#/$defs/PalGender" },
    "level": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
    "passive_skill_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "location_type": { "$ref": "#/$defs/PalLocationType" },
    "location_name": { "type": ["string", "null"], "maxLength": 160 },
    "location_id": { "type": ["string", "null"], "maxLength": 160 },
    "location_slot_index": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 100000
    },
    "location_access_scope": {
      "type": "string",
      "enum": ["player", "guild", "unresolved"]
    },
    "share_enabled": { "type": "boolean" },
    "is_owned_by_requester": { "type": "boolean" }
  }
}
