{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palhatch.local/schemas/canonical-snapshot.schema.json",
  "title": "CanonicalSnapshot",
  "description": "Language-neutral, normalized inventory emitted by a ParserAdapter.",
  "type": "object",
  "additionalProperties": false,
  "required": ["server", "guilds", "players", "pals"],
  "properties": {
    "server": { "$ref": "#/$defs/CanonicalServer" },
    "guilds": {
      "type": "array",
      "items": { "$ref": "#/$defs/CanonicalGuild" }
    },
    "players": {
      "type": "array",
      "items": { "$ref": "#/$defs/CanonicalPlayer" }
    },
    "pals": {
      "type": "array",
      "items": { "$ref": "#/$defs/CanonicalPal" }
    },
    "bases": {
      "type": "array",
      "items": { "$ref": "#/$defs/CanonicalBase" },
      "default": []
    },
    "item_stacks": {
      "type": "array",
      "items": { "$ref": "#/$defs/CanonicalItemStack" },
      "default": []
    },
    "item_inventory_status": {
      "type": "string",
      "enum": ["available", "partial", "unavailable"],
      "default": "unavailable"
    }
  },
  "$defs": {
    "CanonicalServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_uid", "save_version", "captured_at"],
      "properties": {
        "world_uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "save_version": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 120
        },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "CanonicalGuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guild_uid", "name"],
      "properties": {
        "guild_uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "CanonicalPlayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["player_uid", "nickname", "level", "guild_uid"],
      "properties": {
        "player_uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "nickname": { "type": "string", "minLength": 1, "maxLength": 120 },
        "level": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        },
        "guild_uid": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "CanonicalBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_id", "guild_uid", "name"],
      "properties": {
        "base_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "guild_uid": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "CanonicalItemStack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container_id",
        "item_id",
        "quantity",
        "container_type",
        "base_id",
        "guild_uid",
        "slot_index",
        "resolution_status"
      ],
      "properties": {
        "container_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "item_id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "quantity": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "container_type": {
          "type": "string",
          "enum": [
            "storage_box",
            "refrigerator",
            "feed_box",
            "production_output",
            "guild_chest",
            "unknown"
          ]
        },
        "base_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 160
        },
        "guild_uid": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "slot_index": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "resolution_status": {
          "type": "string",
          "enum": ["resolved", "unresolved", "unsupported"]
        }
      }
    },
    "CanonicalPalSourceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_internal_name",
        "source_passive_skill_internal_names"
      ],
      "properties": {
        "source_internal_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "source_passive_skill_internal_names": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    },
    "CanonicalPal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_uid",
        "owner_player_uid",
        "guild_uid",
        "pal_id",
        "is_boss",
        "gender",
        "level",
        "passive_skill_ids",
        "location_type",
        "location_name",
        "location_id",
        "location_slot_index",
        "location_access_scope"
      ],
      "properties": {
        "instance_uid": { "type": "string", "minLength": 1, "maxLength": 160 },
        "owner_player_uid": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "guild_uid": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "pal_id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "is_boss": { "type": "boolean" },
        "gender": {
          "type": "string",
          "enum": ["male", "female", "genderless", "unknown"]
        },
        "level": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        },
        "passive_skill_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "location_type": {
          "type": "string",
          "enum": [
            "player_party",
            "player_storage",
            "base",
            "dimensional_storage",
            "viewing_cage",
            "unknown"
          ]
        },
        "location_name": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 160
        },
        "location_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 160
        },
        "location_slot_index": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100000
        },
        "location_access_scope": {
          "type": "string",
          "enum": ["player", "guild", "unresolved"]
        },
        "metadata": {
          "anyOf": [
            { "$ref": "#/$defs/CanonicalPalSourceMetadata" },
            { "type": "null" }
          ],
          "default": null
        }
      }
    }
  }
}
