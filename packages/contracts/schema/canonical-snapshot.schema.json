{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palhatch.local/schemas/canonical-snapshot.schema.json",
  "title": "CanonicalSnapshot",
  "description": "Language-neutral, normalized inventory emitted by a ParserAdapter.",
  "type": "object",
  "additionalProperties": false,
  "required": ["server", "guilds", "players", "pals"],
  "properties": {
    "server": { "$ref": "#/$defs/CanonicalServer" },
    "guilds": {
      "type": "array",
      "items": { "$ref": "#/$defs/CanonicalGuild" }
    },
    "players": {
      "type": "array",
      "items": { "$ref": "#/$defs/CanonicalPlayer" }
    },
    "pals": {
      "type": "array",
      "items": { "$ref": "#/$defs/CanonicalPal" }
    }
  },
  "$defs": {
    "CanonicalServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_uid", "save_version", "captured_at"],
      "properties": {
        "world_uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "save_version": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 120
        },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "CanonicalGuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guild_uid", "name"],
      "properties": {
        "guild_uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "CanonicalPlayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["player_uid", "nickname", "level", "guild_uid"],
      "properties": {
        "player_uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "nickname": { "type": "string", "minLength": 1, "maxLength": 120 },
        "level": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        },
        "guild_uid": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "CanonicalPal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_uid",
        "owner_player_uid",
        "guild_uid",
        "pal_id",
        "gender",
        "level",
        "passive_skill_ids",
        "location_type",
        "location_name"
      ],
      "properties": {
        "instance_uid": { "type": "string", "minLength": 1, "maxLength": 160 },
        "owner_player_uid": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "guild_uid": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128
        },
        "pal_id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "gender": {
          "type": "string",
          "enum": ["male", "female", "genderless", "unknown"]
        },
        "level": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        },
        "passive_skill_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "location_type": {
          "type": "string",
          "enum": [
            "player_party",
            "player_storage",
            "base",
            "viewing_cage",
            "unknown"
          ]
        },
        "location_name": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 160
        }
      }
    }
  }
}
