{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palhatch.local/schemas/phase8-admin.schema.json",
  "title": "AdminOverview",
  "description": "Phase 8 browser-safe administration, runtime settings, audit, and private Agent command contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent",
    "save_worker",
    "job_worker",
    "candidate_detector",
    "latest_successful_snapshot",
    "parser",
    "catalog",
    "job_counts",
    "ai_provider",
    "recent_failure",
    "disk",
    "deployment_version",
    "stale"
  ],
  "properties": {
    "agent": { "$ref": "#/$defs/AdminWorkerStatus" },
    "save_worker": { "$ref": "#/$defs/AdminWorkerStatus" },
    "job_worker": { "$ref": "#/$defs/AdminWorkerStatus" },
    "candidate_detector": { "$ref": "#/$defs/AdminWorkerStatus" },
    "latest_successful_snapshot": {
      "anyOf": [{ "$ref": "#/$defs/AdminSnapshotSummary" }, { "type": "null" }]
    },
    "parser": { "$ref": "#/$defs/AdminParserIdentity" },
    "catalog": { "$ref": "#/$defs/AdminCatalogIdentity" },
    "job_counts": { "$ref": "#/$defs/AdminJobCounts" },
    "ai_provider": { "$ref": "#/$defs/AdminAIProviderStatus" },
    "recent_failure": {
      "anyOf": [{ "$ref": "#/$defs/AdminFailureSummary" }, { "type": "null" }]
    },
    "disk": { "$ref": "#/$defs/AdminDiskStatus" },
    "deployment_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "stale": { "type": "boolean" }
  },
  "$defs": {
    "Uuid": { "type": "string", "format": "uuid" },
    "NullableUuid": { "type": ["string", "null"], "format": "uuid" },
    "Timestamp": { "type": "string", "format": "date-time" },
    "NullableTimestamp": { "type": ["string", "null"], "format": "date-time" },
    "ContentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "StableErrorCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "IdempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "AdminHealthState": {
      "type": "string",
      "enum": ["healthy", "degraded", "offline", "not_configured", "unknown"]
    },
    "AdminWorkerStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "last_heartbeat_at", "stale"],
      "properties": {
        "state": { "$ref": "#/$defs/AdminHealthState" },
        "last_heartbeat_at": { "$ref": "#/$defs/NullableTimestamp" },
        "stale": { "type": "boolean" }
      }
    },
    "AdminSnapshotSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "captured_at",
        "pal_count",
        "parser_name",
        "parser_version"
      ],
      "properties": {
        "snapshot_id": { "$ref": "#/$defs/Uuid" },
        "captured_at": { "$ref": "#/$defs/Timestamp" },
        "pal_count": { "type": "integer", "minimum": 0 },
        "parser_name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "parser_version": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "AdminParserIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": ["string", "null"], "maxLength": 100 },
        "version": { "type": ["string", "null"], "maxLength": 100 }
      }
    },
    "AdminCatalogIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version_id", "build", "game_version", "content_hash"],
      "properties": {
        "version_id": { "$ref": "#/$defs/NullableUuid" },
        "build": { "type": ["string", "null"], "maxLength": 80 },
        "game_version": { "type": ["string", "null"], "maxLength": 80 },
        "content_hash": {
          "anyOf": [{ "$ref": "#/$defs/ContentHash" }, { "type": "null" }]
        }
      }
    },
    "AdminJobCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending", "processing", "retry", "failed"],
      "properties": {
        "pending": { "type": "integer", "minimum": 0 },
        "processing": { "type": "integer", "minimum": 0 },
        "retry": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "AdminAIProviderStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "state", "degraded", "last_checked_at"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 80 },
        "state": { "$ref": "#/$defs/AdminHealthState" },
        "degraded": { "type": "boolean" },
        "last_checked_at": { "$ref": "#/$defs/NullableTimestamp" }
      }
    },
    "AdminFailureSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_code", "summary", "occurred_at"],
      "properties": {
        "error_code": { "$ref": "#/$defs/StableErrorCode" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
        "occurred_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AdminDiskStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "available_bytes", "checked_at"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["normal", "warning", "critical", "unknown"]
        },
        "available_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "checked_at": { "$ref": "#/$defs/NullableTimestamp" }
      }
    },
    "AdminBindingCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "user_display",
        "role",
        "player_id",
        "player_nickname",
        "world_name",
        "guild_name",
        "binding_version",
        "bound_at",
        "conflict_code"
      ],
      "properties": {
        "user_id": { "$ref": "#/$defs/Uuid" },
        "user_display": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "player"] },
        "player_id": { "$ref": "#/$defs/NullableUuid" },
        "player_nickname": { "type": ["string", "null"], "maxLength": 120 },
        "world_name": { "type": ["string", "null"], "maxLength": 120 },
        "guild_name": { "type": ["string", "null"], "maxLength": 120 },
        "binding_version": { "type": ["integer", "null"], "minimum": 1 },
        "bound_at": { "$ref": "#/$defs/NullableTimestamp" },
        "conflict_code": {
          "anyOf": [{ "$ref": "#/$defs/StableErrorCode" }, { "type": "null" }]
        }
      }
    },
    "AdminBindingEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "user_id",
        "player_id",
        "actor_display",
        "created_at"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/Uuid" },
        "event_type": {
          "type": "string",
          "enum": ["binding_created", "binding_updated", "binding_deleted"]
        },
        "user_id": { "$ref": "#/$defs/Uuid" },
        "player_id": { "$ref": "#/$defs/NullableUuid" },
        "actor_display": { "type": "string", "minLength": 1, "maxLength": 120 },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AdminSaveParserStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker",
        "save_root_configured",
        "read_only_mount",
        "latest_snapshot",
        "review_snapshot_id",
        "recent_failure",
        "parser",
        "parse_duration_ms",
        "pal_count",
        "inventory_drop_state",
        "disk",
        "snapshot_retention_count",
        "stale"
      ],
      "properties": {
        "worker": { "$ref": "#/$defs/AdminWorkerStatus" },
        "save_root_configured": { "type": "boolean" },
        "read_only_mount": {
          "type": "string",
          "enum": ["verified", "unverified", "not_configured"]
        },
        "latest_snapshot": {
          "anyOf": [
            { "$ref": "#/$defs/AdminSnapshotSummary" },
            { "type": "null" }
          ]
        },
        "review_snapshot_id": { "$ref": "#/$defs/NullableUuid" },
        "recent_failure": {
          "anyOf": [
            { "$ref": "#/$defs/AdminFailureSummary" },
            { "type": "null" }
          ]
        },
        "parser": { "$ref": "#/$defs/AdminParserIdentity" },
        "parse_duration_ms": { "type": ["integer", "null"], "minimum": 0 },
        "pal_count": { "type": ["integer", "null"], "minimum": 0 },
        "inventory_drop_state": {
          "type": "string",
          "enum": ["normal", "review_required", "rejected", "unknown"]
        },
        "disk": { "$ref": "#/$defs/AdminDiskStatus" },
        "snapshot_retention_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "stale": { "type": "boolean" }
      }
    },
    "AdminCatalogCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pals",
        "passive_skills",
        "active_skills",
        "pal_active_skills",
        "partner_skills",
        "breeding_recipes",
        "localizations"
      ],
      "properties": {
        "pals": { "type": "integer", "minimum": 0 },
        "passive_skills": { "type": "integer", "minimum": 0 },
        "active_skills": { "type": "integer", "minimum": 0 },
        "pal_active_skills": { "type": "integer", "minimum": 0 },
        "partner_skills": { "type": "integer", "minimum": 0 },
        "breeding_recipes": { "type": "integer", "minimum": 0 },
        "localizations": { "type": "integer", "minimum": 0 }
      }
    },
    "AdminCatalogVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "source",
        "build",
        "game_version",
        "content_hash",
        "package_hash",
        "counts",
        "validation_state",
        "published_world",
        "previous_version_id",
        "diff_summary",
        "provenance",
        "imported_at"
      ],
      "properties": {
        "version_id": { "$ref": "#/$defs/Uuid" },
        "source": { "type": ["string", "null"], "maxLength": 120 },
        "build": { "type": ["string", "null"], "maxLength": 80 },
        "game_version": { "type": ["string", "null"], "maxLength": 80 },
        "content_hash": { "$ref": "#/$defs/ContentHash" },
        "package_hash": { "$ref": "#/$defs/ContentHash" },
        "counts": { "$ref": "#/$defs/AdminCatalogCounts" },
        "validation_state": {
          "type": "string",
          "enum": [
            "extracting",
            "staging",
            "validated",
            "published",
            "rejected"
          ]
        },
        "published_world": { "type": ["string", "null"], "maxLength": 120 },
        "previous_version_id": { "$ref": "#/$defs/NullableUuid" },
        "diff_summary": { "type": "object", "additionalProperties": true },
        "provenance": { "type": "object", "additionalProperties": true },
        "imported_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AdminCatalogAction": {
      "type": "string",
      "enum": [
        "upload",
        "validate",
        "stage",
        "publish",
        "rollback",
        "inspect",
        "warm_cache",
        "reject"
      ]
    },
    "AdminJobSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "requester_display",
        "status",
        "snapshot_id",
        "catalog_version_id",
        "attempt_count",
        "heartbeat_at",
        "locked",
        "error_code",
        "route_count",
        "ai_provider",
        "degraded",
        "execution_plan_id",
        "created_at"
      ],
      "properties": {
        "job_id": { "$ref": "#/$defs/Uuid" },
        "requester_display": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "status": { "type": "string", "minLength": 1, "maxLength": 40 },
        "snapshot_id": { "$ref": "#/$defs/Uuid" },
        "catalog_version_id": { "$ref": "#/$defs/Uuid" },
        "attempt_count": { "type": "integer", "minimum": 0 },
        "heartbeat_at": { "$ref": "#/$defs/NullableTimestamp" },
        "locked": { "type": "boolean" },
        "error_code": {
          "anyOf": [{ "$ref": "#/$defs/StableErrorCode" }, { "type": "null" }]
        },
        "route_count": { "type": "integer", "minimum": 0 },
        "ai_provider": { "type": ["string", "null"], "maxLength": 80 },
        "degraded": { "type": "boolean" },
        "execution_plan_id": { "$ref": "#/$defs/NullableUuid" },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AdminJobAction": {
      "type": "string",
      "enum": [
        "retry",
        "cancel",
        "reap_stale_lock",
        "set_creation_enabled",
        "template_ai_healthcheck"
      ]
    },
    "AIProviderName": {
      "type": "string",
      "enum": ["openai_compatible", "codex_cli", "template"]
    },
    "RuntimeSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_creation_enabled",
        "max_generations",
        "job_worker_concurrency",
        "ai_concurrency",
        "parser_timeout_seconds",
        "snapshot_retention_count",
        "data_stale_threshold_minutes",
        "ai_provider_order",
        "maintenance_announcement"
      ],
      "properties": {
        "job_creation_enabled": { "type": "boolean" },
        "max_generations": { "type": "integer", "minimum": 1, "maximum": 8 },
        "job_worker_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "ai_concurrency": { "type": "integer", "minimum": 1, "maximum": 2 },
        "parser_timeout_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 1800
        },
        "snapshot_retention_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "data_stale_threshold_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440
        },
        "ai_provider_order": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/AIProviderName" }
        },
        "maintenance_announcement": {
          "type": ["string", "null"],
          "maxLength": 500
        }
      }
    },
    "RuntimeSettingsVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_id",
        "version",
        "settings",
        "created_by_display",
        "created_at",
        "rolled_back_from_version"
      ],
      "properties": {
        "version_id": { "$ref": "#/$defs/Uuid" },
        "version": { "type": "integer", "minimum": 1 },
        "settings": { "$ref": "#/$defs/RuntimeSettings" },
        "created_by_display": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "rolled_back_from_version": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "AgentCommandType": {
      "type": "string",
      "enum": [
        "sync_save_once",
        "reparse_snapshot",
        "approve_inventory_snapshot",
        "reject_inventory_snapshot",
        "cleanup_expired_agent_snapshots",
        "retry_breeding_job",
        "cancel_breeding_job",
        "reap_stale_job_lock",
        "template_ai_healthcheck",
        "warm_catalog_cache"
      ]
    },
    "AgentCommandStatus": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "succeeded",
        "failed",
        "rejected",
        "expired"
      ]
    },
    "AgentCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "command_type",
        "payload",
        "idempotency_key",
        "status",
        "created_at",
        "expires_at"
      ],
      "properties": {
        "command_id": { "$ref": "#/$defs/Uuid" },
        "command_type": { "$ref": "#/$defs/AgentCommandType" },
        "payload": { "type": "object", "additionalProperties": true },
        "idempotency_key": { "$ref": "#/$defs/IdempotencyKey" },
        "status": { "$ref": "#/$defs/AgentCommandStatus" },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "expires_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AdminAuditEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "actor_display",
        "target_type",
        "target_id",
        "safe_summary",
        "created_at"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/Uuid" },
        "event_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_.]*$"
        },
        "actor_display": { "type": "string", "minLength": 1, "maxLength": 120 },
        "target_type": { "type": "string", "minLength": 1, "maxLength": 80 },
        "target_id": { "type": ["string", "null"], "maxLength": 160 },
        "safe_summary": { "type": "object", "additionalProperties": true },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "SecretConfigurationStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "last_checked_at"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": {
          "type": "string",
          "enum": ["configured", "not_configured"]
        },
        "last_checked_at": { "$ref": "#/$defs/NullableTimestamp" }
      }
    },
    "AdminErrorCode": {
      "type": "string",
      "enum": [
        "ADMIN_ACCESS_DENIED",
        "ADMIN_AUTH_REQUIRED",
        "ADMIN_DATA_UNAVAILABLE",
        "ADMIN_CONTRACT_INVALID",
        "BINDING_CONFLICT",
        "BINDING_VERSION_CONFLICT",
        "BINDING_NOT_FOUND",
        "AGENT_COMMAND_NOT_ALLOWED",
        "AGENT_COMMAND_EXPIRED",
        "AGENT_COMMAND_CONFLICT",
        "CATALOG_UPLOAD_INVALID",
        "CATALOG_UPLOAD_CONFLICT",
        "CATALOG_UPLOAD_NOT_FOUND",
        "CATALOG_UPLOAD_INCOMPLETE",
        "CATALOG_UPLOAD_NOT_READY",
        "CATALOG_UPLOAD_NOT_VALIDATED",
        "CATALOG_ACTION_INVALID",
        "CATALOG_ACTION_CONFLICT",
        "CATALOG_CONFIRMATION_REQUIRED",
        "JOB_ACTION_INVALID",
        "RUNTIME_SETTINGS_INVALID",
        "RUNTIME_SETTINGS_VERSION_CONFLICT",
        "RUNTIME_SETTINGS_NOT_FOUND"
      ]
    },
    "AdminError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_code", "retryable"],
      "properties": {
        "error_code": { "$ref": "#/$defs/AdminErrorCode" },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
