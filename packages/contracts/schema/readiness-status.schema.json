{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palhatch.local/schemas/readiness-status.schema.json",
  "title": "ReadinessStatus",
  "description": "Language-neutral readiness status returned by the private Agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "service",
    "version",
    "timestamp",
    "error_code",
    "database_configured",
    "job_worker_configured",
    "save_worker_configured",
    "game_catalog"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ready", "not_ready"]
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "error_code": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "database_configured": { "type": "boolean" },
    "job_worker_configured": { "type": "boolean" },
    "save_worker_configured": { "type": "boolean" },
    "game_catalog": { "$ref": "#/$defs/GameCatalogHealth" }
  },
  "$defs": {
    "GameCatalogHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "active_version_id", "cache_status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_configured", "configured", "error"]
        },
        "active_version_id": { "type": ["string", "null"], "format": "uuid" },
        "cache_status": { "type": "string", "enum": ["empty", "warm", "error"] }
      }
    }
  }
}
