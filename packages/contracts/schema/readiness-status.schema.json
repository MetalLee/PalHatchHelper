{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palhatch.local/schemas/readiness-status.schema.json",
  "title": "ReadinessStatus",
  "description": "Language-neutral readiness status returned by the private Agent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "service", "version", "timestamp", "error_code"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ready", "not_ready"]
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "error_code": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  }
}
