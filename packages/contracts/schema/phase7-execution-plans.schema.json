{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palhatch.local/schemas/phase7-execution-plans.schema.json",
  "title": "SavePlanRequest",
  "description": "Phase 7 read-only My Plans route-save contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["route_id"],
  "properties": {
    "route_id": { "type": "string", "format": "uuid" }
  },
  "$defs": {
    "StableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "Timestamp": { "type": "string", "format": "date-time" },
    "OptimizationMode": {
      "type": "string",
      "enum": ["balanced", "fastest", "highest_success", "least_borrowing"]
    },
    "FeasibilityStatus": {
      "type": "string",
      "enum": ["ready", "needs_inventory"]
    },
    "PlanDifficulty": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "Phase7ErrorCode": {
      "type": "string",
      "enum": [
        "AUTH_REQUIRED",
        "PLAYER_BINDING_REQUIRED",
        "PLAN_NOT_FOUND",
        "PLAN_ACCESS_DENIED",
        "ROUTE_NOT_FOUND",
        "DATA_UNAVAILABLE"
      ]
    },
    "PlanPassiveSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passive_skill_id", "display_name", "rank", "is_negative"],
      "properties": {
        "passive_skill_id": { "$ref": "#/$defs/StableId" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "rank": { "type": ["integer", "null"], "minimum": -20, "maximum": 20 },
        "is_negative": { "type": ["boolean", "null"] }
      }
    },
    "SavePlanRequest": { "$ref": "#/$defs/SavePlanRequestBody" },
    "SavePlanRequestBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id"],
      "properties": {
        "route_id": { "type": "string", "format": "uuid" }
      }
    },
    "SavePlanResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "saved_at", "reused"],
      "properties": {
        "route_id": { "type": "string", "format": "uuid" },
        "saved_at": { "$ref": "#/$defs/Timestamp" },
        "reused": { "type": "boolean" }
      }
    },
    "RemovePlanResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "removed"],
      "properties": {
        "route_id": { "type": "string", "format": "uuid" },
        "removed": { "type": "boolean" }
      }
    },
    "PlanSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "source_job_id",
        "target_pal_id",
        "target_pal_display_name",
        "desired_passive_ids",
        "desired_passive_display_names",
        "desired_passives",
        "optimization_mode",
        "feasibility_status",
        "generation_count",
        "step_count",
        "borrowed_pal_count",
        "missing_pal_count",
        "estimated_attempts_min",
        "estimated_attempts_max",
        "difficulty",
        "total_score",
        "saved_at"
      ],
      "properties": {
        "route_id": { "type": "string", "format": "uuid" },
        "source_job_id": { "type": "string", "format": "uuid" },
        "target_pal_id": { "$ref": "#/$defs/StableId" },
        "target_pal_display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "desired_passive_ids": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/StableId" }
        },
        "desired_passive_display_names": {
          "type": "array",
          "maxItems": 4,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "desired_passives": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/PlanPassiveSummary" }
        },
        "optimization_mode": { "$ref": "#/$defs/OptimizationMode" },
        "feasibility_status": { "$ref": "#/$defs/FeasibilityStatus" },
        "generation_count": { "type": "integer", "minimum": 0, "maximum": 8 },
        "step_count": { "type": "integer", "minimum": 0 },
        "borrowed_pal_count": { "type": "integer", "minimum": 0 },
        "missing_pal_count": { "type": "integer", "minimum": 0 },
        "estimated_attempts_min": { "type": "integer", "minimum": 0 },
        "estimated_attempts_max": { "type": "integer", "minimum": 0 },
        "difficulty": { "$ref": "#/$defs/PlanDifficulty" },
        "total_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "saved_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "PlanDetailReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "source_job_id", "saved_at"],
      "properties": {
        "route_id": { "type": "string", "format": "uuid" },
        "source_job_id": { "type": "string", "format": "uuid" },
        "saved_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "PlanListPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "next_cursor", "query_boundary"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/PlanSummary" }
        },
        "next_cursor": { "type": ["string", "null"], "maxLength": 300 },
        "query_boundary": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "PlanRpcFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error_code"],
      "properties": {
        "ok": { "const": false },
        "error_code": { "$ref": "#/$defs/Phase7ErrorCode" }
      }
    },
    "PlanListRpcSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "data"],
      "properties": {
        "ok": { "const": true },
        "data": { "$ref": "#/$defs/PlanListPage" }
      }
    },
    "PlanListRpcResult": {
      "anyOf": [
        { "$ref": "#/$defs/PlanListRpcSuccess" },
        { "$ref": "#/$defs/PlanRpcFailure" }
      ]
    },
    "PlanDetailRpcSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "data"],
      "properties": {
        "ok": { "const": true },
        "data": { "$ref": "#/$defs/PlanDetailReference" }
      }
    },
    "PlanDetailRpcResult": {
      "anyOf": [
        { "$ref": "#/$defs/PlanDetailRpcSuccess" },
        { "$ref": "#/$defs/PlanRpcFailure" }
      ]
    }
  }
}
