{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palhatch.local/schemas/phase6-breeder.schema.json",
  "title": "CreateBreedingJobRequest",
  "description": "Phase 6 browser, Worker explanation, and route-comparison contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_pal_id",
    "desired_passive_ids",
    "optimization_mode",
    "allow_guild_shared",
    "max_generations"
  ],
  "properties": {
    "target_pal_id": { "$ref": "#/$defs/BreederStableId" },
    "desired_passive_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/BreederStableId" }
    },
    "optimization_mode": { "$ref": "#/$defs/BreederOptimizationMode" },
    "allow_guild_shared": { "type": "boolean" },
    "max_generations": { "type": "integer", "minimum": 1, "maximum": 8 }
  },
  "$defs": {
    "BreederStableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "BreederSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "BreederOptimizationMode": {
      "type": "string",
      "enum": ["balanced", "fastest", "highest_success", "least_borrowing"]
    },
    "BreederJobStatus": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "algorithm_completed",
        "ai_enriching",
        "retry_pending",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "BreederDifficulty": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "AIProviderName": {
      "type": "string",
      "enum": ["openai_compatible", "codex_cli", "template"]
    },
    "CreateBreedingJobResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "reused", "status"],
      "properties": {
        "job_id": { "type": "string", "format": "uuid" },
        "reused": { "type": "boolean" },
        "status": { "$ref": "#/$defs/BreederJobStatus" }
      }
    },
    "BreederCatalogPalOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pal_id",
        "encyclopedia_no",
        "display_name",
        "element_types"
      ],
      "properties": {
        "pal_id": { "$ref": "#/$defs/BreederStableId" },
        "encyclopedia_no": { "type": ["integer", "null"], "minimum": 1 },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "element_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "BreederPassiveOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passive_skill_id", "display_name", "rank", "is_negative"],
      "properties": {
        "passive_skill_id": { "$ref": "#/$defs/BreederStableId" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "rank": { "type": "integer" },
        "is_negative": { "type": "boolean" }
      }
    },
    "BreederPalLocalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pal_id", "display_name"],
      "properties": {
        "pal_id": { "$ref": "#/$defs/BreederStableId" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "BreederPassiveLocalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passive_skill_id", "display_name"],
      "properties": {
        "passive_skill_id": { "$ref": "#/$defs/BreederStableId" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "BreederRouteLocalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale", "pals", "passive_skills"],
      "properties": {
        "locale": { "type": "string", "minLength": 2, "maxLength": 20 },
        "pals": {
          "type": "array",
          "items": { "$ref": "#/$defs/BreederPalLocalization" }
        },
        "passive_skills": {
          "type": "array",
          "items": { "$ref": "#/$defs/BreederPassiveLocalization" }
        }
      }
    },
    "BreederFormContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_state",
        "inventory_snapshot_id",
        "game_data_version_id",
        "game_data_content_hash",
        "game_build_id",
        "game_version",
        "algorithm_version",
        "scoring_profile_versions",
        "pals",
        "passive_skills"
      ],
      "properties": {
        "data_state": {
          "type": "string",
          "enum": ["healthy", "stale", "parse_error"]
        },
        "inventory_snapshot_id": { "type": "string", "format": "uuid" },
        "game_data_version_id": { "type": "string", "format": "uuid" },
        "game_data_content_hash": { "$ref": "#/$defs/BreederSha256" },
        "game_build_id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "game_version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "algorithm_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "scoring_profile_versions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "balanced",
            "fastest",
            "highest_success",
            "least_borrowing"
          ],
          "properties": {
            "balanced": { "type": "string", "minLength": 1, "maxLength": 100 },
            "fastest": { "type": "string", "minLength": 1, "maxLength": 100 },
            "highest_success": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "least_borrowing": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        },
        "pals": {
          "type": "array",
          "items": { "$ref": "#/$defs/BreederCatalogPalOption" }
        },
        "passive_skills": {
          "type": "array",
          "items": { "$ref": "#/$defs/BreederPassiveOption" }
        }
      }
    },
    "BreederFormContextRpcSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "data"],
      "properties": {
        "ok": { "const": true },
        "data": { "$ref": "#/$defs/BreederFormContext" }
      }
    },
    "BreederFormContextRpcFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error_code"],
      "properties": {
        "ok": { "const": false },
        "error_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
      }
    },
    "BreederFormContextRpcResult": {
      "anyOf": [
        { "$ref": "#/$defs/BreederFormContextRpcSuccess" },
        { "$ref": "#/$defs/BreederFormContextRpcFailure" }
      ]
    },
    "JobProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "attempt_count", "error_code"],
      "properties": {
        "status": { "$ref": "#/$defs/BreederJobStatus" },
        "attempt_count": { "type": "integer", "minimum": 0 },
        "error_code": {
          "type": ["string", "null"],
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "maxLength": 100
        }
      }
    },
    "RouteRawScoreMetrics": {
      "description": "Browser projection for immutable v2 history and current v3 routes; acquisition fields are absent from v2 payloads.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_count",
        "step_count",
        "unique_starting_instance_count",
        "borrowed_pal_count",
        "inventory_coverage",
        "passive_carrier_count",
        "passive_concentration",
        "extra_passive_count",
        "intermediate_pal_count",
        "intermediate_passive_checkpoint_count",
        "required_gender_checkpoint_count",
        "estimated_attempts_min",
        "estimated_attempts_max",
        "difficulty"
      ],
      "properties": {
        "generation_count": { "type": "integer", "minimum": 0 },
        "step_count": { "type": "integer", "minimum": 0 },
        "unique_starting_instance_count": { "type": "integer", "minimum": 0 },
        "starting_requirement_count": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "missing_pal_count": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "missing_passive_requirement_count": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "missing_passive_count": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "borrowed_pal_count": { "type": "integer", "minimum": 0 },
        "inventory_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "inventory_passive_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        },
        "passive_carrier_count": { "type": "integer", "minimum": 0 },
        "passive_concentration": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "extra_passive_count": { "type": "integer", "minimum": 0 },
        "intermediate_pal_count": { "type": "integer", "minimum": 0 },
        "intermediate_passive_checkpoint_count": {
          "type": "integer",
          "minimum": 0
        },
        "required_gender_checkpoint_count": { "type": "integer", "minimum": 0 },
        "estimated_attempts_min": { "type": "integer", "minimum": 0 },
        "estimated_attempts_max": { "type": "integer", "minimum": 0 },
        "difficulty": { "$ref": "#/$defs/BreederDifficulty" }
      }
    },
    "RouteScoreComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "raw_value",
        "normalized_score",
        "weight",
        "weighted_score"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "route_length",
            "inventory_coverage",
            "passive_concentration",
            "borrowing",
            "intermediate_cost",
            "attempt_cost",
            "stability",
            "acquisition_cost"
          ]
        },
        "raw_value": { "type": "number", "minimum": 0 },
        "normalized_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "weighted_score": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "RouteModeScore": {
      "description": "Browser projection accepts the seven v2 components and the eight v3 components; the engine contract remains version-strict.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optimization_mode",
        "scoring_profile_version",
        "total_score",
        "components"
      ],
      "properties": {
        "optimization_mode": { "$ref": "#/$defs/BreederOptimizationMode" },
        "scoring_profile_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "total_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "components": {
          "type": "array",
          "minItems": 7,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/RouteScoreComponent" }
        }
      }
    },
    "RouteScoreBreakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scoring_profile_version",
        "estimate_basis",
        "raw_metrics",
        "mode_scores"
      ],
      "properties": {
        "scoring_profile_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "estimate_basis": {
          "type": "string",
          "const": "strategy_heuristic_no_verified_probability"
        },
        "raw_metrics": { "$ref": "#/$defs/RouteRawScoreMetrics" },
        "mode_scores": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/RouteModeScore" }
        }
      }
    },
    "BreedingRouteViewParent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "pal_id",
        "instance_uid",
        "owner_display_name",
        "gender",
        "passive_skill_ids",
        "required_passive_ids",
        "borrowed",
        "produced_by_step_index",
        "location_type",
        "location_name"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["inventory", "intermediate", "missing"]
        },
        "pal_id": { "$ref": "#/$defs/BreederStableId" },
        "instance_uid": { "type": ["string", "null"], "maxLength": 160 },
        "owner_display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "gender": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["male", "female", "genderless", "unknown"]
            },
            { "type": "null" }
          ]
        },
        "passive_skill_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/BreederStableId" }
        },
        "required_passive_ids": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/BreederStableId" }
        },
        "borrowed": { "type": "boolean" },
        "produced_by_step_index": { "type": ["integer", "null"], "minimum": 0 },
        "location_type": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "player_party",
                "player_storage",
                "base",
                "dimensional_storage",
                "viewing_cage",
                "unknown"
              ]
            },
            { "type": "null" }
          ]
        },
        "location_name": { "type": ["string", "null"], "maxLength": 160 }
      }
    },
    "BreedingRouteViewStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_index",
        "generation",
        "recipe_type",
        "parent_a",
        "parent_b",
        "child_pal_id",
        "child_required_gender",
        "required_passive_ids"
      ],
      "properties": {
        "step_index": { "type": "integer", "minimum": 0 },
        "generation": { "type": "integer", "minimum": 1, "maximum": 8 },
        "recipe_type": { "type": "string", "enum": ["normal", "special"] },
        "parent_a": { "$ref": "#/$defs/BreedingRouteViewParent" },
        "parent_b": { "$ref": "#/$defs/BreedingRouteViewParent" },
        "child_pal_id": { "$ref": "#/$defs/BreederStableId" },
        "child_required_gender": {
          "anyOf": [
            { "type": "string", "enum": ["male", "female"] },
            { "type": "null" }
          ]
        },
        "required_passive_ids": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/BreederStableId" }
        }
      }
    },
    "BreedingMissingRequirementView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pal_id",
        "gender",
        "required_passive_ids",
        "quantity",
        "step_indexes"
      ],
      "properties": {
        "pal_id": { "$ref": "#/$defs/BreederStableId" },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "required_passive_ids": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/BreederStableId" }
        },
        "quantity": { "type": "integer", "minimum": 1 },
        "step_indexes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "BreedingPassiveSourceView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passive_id",
        "source_instance_uid",
        "source_pal_id",
        "first_required_step_index"
      ],
      "properties": {
        "passive_id": { "$ref": "#/$defs/BreederStableId" },
        "source_instance_uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "source_pal_id": { "$ref": "#/$defs/BreederStableId" },
        "first_required_step_index": { "type": "integer", "minimum": 0 }
      }
    },
    "AIExplanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "explanation", "degraded"],
      "properties": {
        "provider": { "$ref": "#/$defs/AIProviderName" },
        "model": { "type": ["string", "null"], "maxLength": 120 },
        "explanation": { "type": ["string", "null"], "maxLength": 10000 },
        "degraded": { "type": "boolean" }
      }
    },
    "AIExplanationRouteSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_key",
        "rank",
        "total_score",
        "generation_count",
        "borrowed_pal_count",
        "inventory_coverage",
        "difficulty",
        "pal_sequence",
        "score_breakdown"
      ],
      "properties": {
        "route_key": { "$ref": "#/$defs/BreederSha256" },
        "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
        "total_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "generation_count": { "type": "integer", "minimum": 0, "maximum": 8 },
        "borrowed_pal_count": { "type": "integer", "minimum": 0 },
        "inventory_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "difficulty": { "$ref": "#/$defs/BreederDifficulty" },
        "pal_sequence": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/BreederStableId" }
        },
        "score_breakdown": { "$ref": "#/$defs/RouteScoreBreakdown" }
      }
    },
    "AIExplanationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_pal_id",
        "desired_passive_ids",
        "optimization_mode",
        "version_summary",
        "routes"
      ],
      "properties": {
        "target_pal_id": { "$ref": "#/$defs/BreederStableId" },
        "desired_passive_ids": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/BreederStableId" }
        },
        "optimization_mode": { "$ref": "#/$defs/BreederOptimizationMode" },
        "version_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "game_data_content_hash",
            "algorithm_version",
            "scoring_profile_version"
          ],
          "properties": {
            "game_data_content_hash": { "$ref": "#/$defs/BreederSha256" },
            "algorithm_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "scoring_profile_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        },
        "routes": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/AIExplanationRouteSummary" }
        }
      }
    },
    "AIRouteExplanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_key", "explanation", "labels"],
      "properties": {
        "route_key": { "$ref": "#/$defs/BreederSha256" },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "labels": {
          "type": "array",
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "AIExplanationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "degraded",
        "explanation",
        "route_explanations"
      ],
      "properties": {
        "provider": { "$ref": "#/$defs/AIProviderName" },
        "model": { "type": ["string", "null"], "maxLength": 120 },
        "degraded": { "type": "boolean" },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "route_explanations": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/AIRouteExplanation" }
        }
      }
    },
    "BreedingRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "execution_plan_id",
        "route_key",
        "rank",
        "optimization_mode",
        "total_score",
        "generation_count",
        "step_count",
        "estimated_attempts_min",
        "estimated_attempts_max",
        "difficulty",
        "borrowed_pal_count",
        "inventory_coverage",
        "inventory_passive_coverage",
        "inheritance_score",
        "feasibility_status",
        "adoptable",
        "missing_pal_count",
        "missing_passive_ids",
        "missing_requirements",
        "passive_sources",
        "existing_target_instance_uid",
        "score_breakdown",
        "steps",
        "ai_explanation",
        "ai_labels"
      ],
      "properties": {
        "route_id": { "type": "string", "format": "uuid" },
        "execution_plan_id": { "type": ["string", "null"], "format": "uuid" },
        "route_key": { "$ref": "#/$defs/BreederSha256" },
        "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
        "optimization_mode": { "$ref": "#/$defs/BreederOptimizationMode" },
        "total_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "generation_count": { "type": "integer", "minimum": 0, "maximum": 8 },
        "step_count": { "type": "integer", "minimum": 0 },
        "estimated_attempts_min": { "type": "integer", "minimum": 0 },
        "estimated_attempts_max": { "type": "integer", "minimum": 0 },
        "difficulty": { "$ref": "#/$defs/BreederDifficulty" },
        "borrowed_pal_count": { "type": "integer", "minimum": 0 },
        "inventory_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "inventory_passive_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "inheritance_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "feasibility_status": {
          "type": "string",
          "enum": ["ready", "needs_inventory"]
        },
        "adoptable": { "type": "boolean" },
        "missing_pal_count": { "type": "integer", "minimum": 0 },
        "missing_passive_ids": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/BreederStableId" }
        },
        "missing_requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/BreedingMissingRequirementView" }
        },
        "passive_sources": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/BreedingPassiveSourceView" }
        },
        "existing_target_instance_uid": {
          "type": ["string", "null"],
          "maxLength": 160
        },
        "score_breakdown": { "$ref": "#/$defs/RouteScoreBreakdown" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/BreedingRouteViewStep" }
        },
        "ai_explanation": { "type": ["string", "null"], "maxLength": 4000 },
        "ai_labels": {
          "type": "array",
          "maxItems": 6,
          "items": { "type": "string", "maxLength": 80 }
        }
      }
    },
    "BreedingPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "result_digest",
        "route_count",
        "missing_passive_ids",
        "explanation_codes",
        "diagnostics",
        "ai",
        "routes"
      ],
      "properties": {
        "plan_id": { "type": "string", "format": "uuid" },
        "result_digest": { "$ref": "#/$defs/BreederSha256" },
        "route_count": { "type": "integer", "minimum": 0, "maximum": 3 },
        "missing_passive_ids": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/BreederStableId" }
        },
        "explanation_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        },
        "diagnostics": { "type": "object", "additionalProperties": true },
        "ai": { "$ref": "#/$defs/AIExplanation" },
        "routes": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/BreedingRoute" }
        }
      }
    },
    "RouteComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "progress",
        "target_pal_id",
        "desired_passive_ids",
        "optimization_mode",
        "allow_guild_shared",
        "max_generations",
        "inventory_snapshot_id",
        "game_data_version_id",
        "game_data_content_hash",
        "algorithm_version",
        "scoring_profile_version",
        "localization",
        "created_at",
        "completed_at",
        "plan"
      ],
      "properties": {
        "job_id": { "type": "string", "format": "uuid" },
        "progress": { "$ref": "#/$defs/JobProgress" },
        "target_pal_id": { "$ref": "#/$defs/BreederStableId" },
        "desired_passive_ids": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/BreederStableId" }
        },
        "optimization_mode": { "$ref": "#/$defs/BreederOptimizationMode" },
        "allow_guild_shared": { "type": "boolean" },
        "max_generations": { "type": "integer", "minimum": 1, "maximum": 8 },
        "inventory_snapshot_id": { "type": "string", "format": "uuid" },
        "game_data_version_id": { "type": "string", "format": "uuid" },
        "game_data_content_hash": { "$ref": "#/$defs/BreederSha256" },
        "algorithm_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "scoring_profile_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "localization": { "$ref": "#/$defs/BreederRouteLocalization" },
        "created_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "plan": {
          "anyOf": [{ "$ref": "#/$defs/BreedingPlan" }, { "type": "null" }]
        }
      }
    },
    "BreedingError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_code"],
      "properties": {
        "error_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "BreedingJobDetailRpcSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "data"],
      "properties": {
        "ok": { "const": true },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "job_id",
            "status",
            "target_pal_id",
            "desired_passive_ids",
            "optimization_mode",
            "allow_guild_shared",
            "max_generations",
            "inventory_snapshot_id",
            "game_data_version_id",
            "game_data_content_hash",
            "algorithm_version",
            "scoring_profile_version",
            "localization",
            "attempt_count",
            "error_code",
            "created_at",
            "completed_at",
            "plan"
          ],
          "properties": {
            "job_id": { "type": "string", "format": "uuid" },
            "status": { "$ref": "#/$defs/BreederJobStatus" },
            "target_pal_id": { "$ref": "#/$defs/BreederStableId" },
            "desired_passive_ids": {
              "type": "array",
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/BreederStableId" }
            },
            "optimization_mode": { "$ref": "#/$defs/BreederOptimizationMode" },
            "allow_guild_shared": { "type": "boolean" },
            "max_generations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "inventory_snapshot_id": { "type": "string", "format": "uuid" },
            "game_data_version_id": { "type": "string", "format": "uuid" },
            "game_data_content_hash": { "$ref": "#/$defs/BreederSha256" },
            "algorithm_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "scoring_profile_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "localization": { "$ref": "#/$defs/BreederRouteLocalization" },
            "attempt_count": { "type": "integer", "minimum": 0 },
            "error_code": {
              "type": ["string", "null"],
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "created_at": { "type": "string", "format": "date-time" },
            "completed_at": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "plan": {
              "anyOf": [{ "$ref": "#/$defs/BreedingPlan" }, { "type": "null" }]
            }
          }
        }
      }
    },
    "BreedingJobDetailRpcFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error_code"],
      "properties": {
        "ok": { "const": false },
        "error_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
      }
    },
    "BreedingJobDetailRpcResult": {
      "anyOf": [
        { "$ref": "#/$defs/BreedingJobDetailRpcSuccess" },
        { "$ref": "#/$defs/BreedingJobDetailRpcFailure" }
      ]
    }
  }
}
