  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202607" />
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.2.202607" />
    <PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.9" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../../packages/contracts/schema/game-catalog.schema.json"
                      LogicalName="PalHatchHelper.GameCatalogSchema.json" />
    <InternalsVisibleTo Include="PalworldCatalogExtractor.Tests" />
  </ItemGroup>
</Project>
