# False local-only placeholders. Never place production credentials here.
APP_ENV=development
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=example-service-role-key
WORKER_ID=palhatch-agent-local
JOB_POLL_INTERVAL_SECONDS=2
JOB_HEARTBEAT_INTERVAL_SECONDS=10
JOB_LEASE_TIMEOUT_SECONDS=30
JOB_LEASE_SAFETY_MARGIN_SECONDS=5
JOB_STALE_REAP_INTERVAL_SECONDS=15
JOB_SHUTDOWN_GRACE_SECONDS=30
