PALWORLD_SAVE_ROOT=
PALWORLD_WORLD_ID=
PALWORLD_WORLD_UID=
PARSER_NAME=
PARSER_VERSION=
PARSER_COMMAND_JSON=[]
PARSER_REQUIRED_FILES_JSON=[]
SAVE_POLL_INTERVAL_SECONDS=300
SAVE_STABILITY_DELAY_SECONDS=10
PARSER_TIMEOUT_SECONDS=180
PARSER_MEMORY_LIMIT_BYTES=1610612736
